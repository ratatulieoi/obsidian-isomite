{
  "name": "isomite",
  "version": "0.4.0",
  "private": true,
  "description": "Connect an Obsidian vault to a private Cloudflare R2 bucket for controlled synchronization.",
  "main": "main.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ratatulieoi/obsidian-isomite.git"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/parser": "^8.67.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.8.1",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "obsidian": "latest",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "minimatch": "^10.2.4",
    "node-diff3": "^3.2.1"
  }
}
